# Copie para profiles.yml nesta pasta (ou ~/.dbt/profiles.yml).
# O dbt-duckdb grava as tabelas diamond.* no mesmo arquivo que o dashboard lê.
# Rode de dentro de dbt/censo_escolar:  dbt run --profiles-dir .

censo_escolar:
  target: dev
  outputs:
    dev:
      type: duckdb
      path: "{{ env_var('DUCKDB_PATH', '../../dashboard/dados/censo.duckdb') }}"
      schema: main
      threads: 4
