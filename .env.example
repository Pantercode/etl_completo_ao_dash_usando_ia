# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA comite o arquivo ".env" de verdade (ele já está no .gitignore).

# --- Supabase / Postgres (camada gold/diamond) ---
# Pegue em: Supabase > Project Settings > Database > Connection string (modo "Session pooler" ou direto)
SUPABASE_DB_URL=postgresql://postgres:SENHA@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# --- Google Gemini (IA generativa do dashboard) ---
# Pegue em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=coloque_sua_chave_aqui
GEMINI_MODEL=gemini-2.5-flash

# --- Ambiente PySpark (Windows) ---
JAVA_HOME=C:\Program Files\Java\jdk-17
HADOOP_HOME=C:\Users\marcell.oliveira\hadoop
